{
  "name": "hds-android",
  "version": "0.1.0-preview.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:host": "node scripts/build-mobile-host.mjs",
    "test": "npm run build:host && node --import tsx --test tests/*.test.ts",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@cordisjs/plugin-http": "0.6.3",
    "@minatojs/driver-sqlite": "4.7.0",
    "koishi": "4.18.11",
    "qface": "1.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.0.7"
  }
}
